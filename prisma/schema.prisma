// Design and rationale: docs/schema.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ScanStatus {
  queued
  running
  completed
  failed
}

enum ScanError {
  package_not_found
  version_not_found
  tarball_too_large
  timeout
  internal_error
}

enum RiskLevel {
  low
  medium
  high
}

enum Severity {
  low
  medium
  high
}

enum CheckType {
  install_scripts
  typosquatting
  obfuscation
  maintainer_anomaly
  suspicious_dependency
}

enum ReviewVerdict {
  malicious
  benign
}

enum EmailTokenType {
  verify_email
  reset_password
}

model Role {
  id              BigInt   @id @default(autoincrement())
  uid             String   @unique @default(dbgenerated("generate_uid()"))
  name            String   @unique
  rolePermissions Json?    @map("role_permissions")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id              BigInt    @id @default(autoincrement())
  uid             String    @unique @default(dbgenerated("generate_uid()"))
  userName        String    @unique @map("user_name")
  email           String    @unique
  passwordHash    String    @map("password_hash")
  roleId          BigInt    @map("role_id")
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  roleInfo    Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scans       Scan[]
  reviews     Review[]
  emailTokens EmailToken[]

  @@map("users")
}

model EmailToken {
  id        BigInt         @id @default(autoincrement())
  uid       String         @unique @default(dbgenerated("generate_uid()"))
  userId    BigInt         @map("user_id")
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  createdAt DateTime       @default(now()) @map("created_at")

  userInfo User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

model Package {
  id        BigInt   @id @default(autoincrement())
  uid       String   @unique @default(dbgenerated("generate_uid()"))
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  packageVersions PackageVersion[]

  @@map("packages")
}

model PackageVersion {
  id          BigInt    @id @default(autoincrement())
  uid         String    @unique @default(dbgenerated("generate_uid()"))
  packageId   BigInt    @map("package_id")
  version     String
  publishedAt DateTime? @map("published_at")
  tarballUrl  String    @map("tarball_url")
  integrity   String?
  createdAt   DateTime  @default(now()) @map("created_at")

  packageInfo Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  scans       Scan[]
  reviews     Review[]

  @@unique([packageId, version])
  @@map("package_versions")
}

model Scan {
  id               BigInt     @id @default(autoincrement())
  uid              String     @unique @default(dbgenerated("generate_uid()"))
  userId           BigInt?    @map("user_id")
  packageName      String     @map("package_name")
  requestedVersion String?    @map("requested_version")
  packageVersionId BigInt?    @map("package_version_id")
  status           ScanStatus @default(queued)
  riskScore        Int?       @map("risk_score") @db.SmallInt
  riskLevel        RiskLevel? @map("risk_level")
  error            ScanError?
  metadataSnapshot Json?      @map("metadata_snapshot")
  analyzerVersion  String?    @map("analyzer_version")
  createdAt        DateTime   @default(now()) @map("created_at")
  startedAt        DateTime?  @map("started_at")
  completedAt      DateTime?  @map("completed_at")

  scannerInfo        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  packageVersionInfo PackageVersion? @relation(fields: [packageVersionId], references: [id], onDelete: SetNull)
  findings           Finding[]

  @@index([packageVersionId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("scans")
}

model Finding {
  id        BigInt    @id @default(autoincrement())
  uid       String    @unique @default(dbgenerated("generate_uid()"))
  scanId    BigInt    @map("scan_id")
  checkType CheckType @map("check_type")
  severity  Severity
  summary   String
  evidence  String
  details   Json?
  createdAt DateTime  @default(now()) @map("created_at")

  scanInfo Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@map("findings")
}

model Review {
  id               BigInt        @id @default(autoincrement())
  uid              String        @unique @default(dbgenerated("generate_uid()"))
  packageVersionId BigInt        @map("package_version_id")
  verdict          ReviewVerdict
  source           String
  sourceRef        String?       @map("source_ref")
  notes            String?
  reviewedBy       BigInt?       @map("reviewed_by")
  createdAt        DateTime      @default(now()) @map("created_at")

  packageVersionInfo PackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)
  reviewerInfo       User?          @relation(fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([packageVersionId, source])
  @@map("reviews")
}
