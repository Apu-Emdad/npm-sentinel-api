# Copy to .env and adjust. docker-compose.yml and the app both read .env.

# App
NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=npm_sentinel
POSTGRES_PORT=5433

# Prisma connection string; keep in sync with the values above
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5433/npm_sentinel

# Redis (docker compose)
REDIS_HOST=localhost
REDIS_PORT=6380

# Auth
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Access token lifetime in seconds (86400 = 1 day)
JWT_EXPIRES_IN=86400
