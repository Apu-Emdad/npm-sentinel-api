# Copy to .env and adjust. docker-compose.yml and the app both read .env.

# App
NODE_ENV=development
PORT=7000

# PostgreSQL (docker compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=npm_sentinel
POSTGRES_PORT=5433

# Prisma connection string; keep in sync with the values above
DATABASE_URL=postgresql://admin:admin@localhost:5433/npm_sentinel

# Redis (docker compose)
REDIS_HOST=localhost
REDIS_PORT=6381
# Database number 0 to 15. Apps sharing one Redis server must use different numbers.
REDIS_DB=0

# Auth
# Secrets: at least 32 characters each, and different from each other.
# Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-of-32-plus-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-of-32-plus-characters
# Lifetimes in seconds (900 = 15 minutes, 604800 = 7 days)
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Scans: POST /scans requests allowed per IP in each window (seconds)
SCAN_RATE_LIMIT=10
SCAN_RATE_WINDOW=3600

# Web app origin, allowed by CORS to send the refresh cookie
WEB_ORIGIN=http://localhost:7001

# Base URL of the web app, used for the links in emails
WEB_URL=http://localhost:7001

# Email (SMTP). Works with any SMTP provider, e.g. Brevo: smtp-relay.brevo.com:587,
# login and SMTP key from Brevo > SMTP & API. MAIL_FROM must be a verified sender.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-key
MAIL_FROM="npm-sentinel <npmsentinel@gmail.com>"
